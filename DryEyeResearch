ios)\n","# ============================================================\n","\n","# Model: Predicting probability of Severe Dry Eye\n","logit_model = smf.logit(\n","    formula='IS_SEVERE ~ AGE + C(GENDER) + C(SYSTEMIC_DISEASE) + BLINK_RATE',\n","    data=df\n",").fit(disp=False)\n","\n","params = logit_model.params\n","conf = logit_model.conf_int()\n","conf['Odds Ratio'] = params\n","conf.columns = ['95% CI Lower', '95% CI Upper', 'Odds Ratio']\n","\n","# Exponentiate coefficients to get Odds Ratios\n","table5 = np.exp(conf)\n","table5['p-value'] = logit_model.pvalues.round(4)\n","table5 = table5[['Odds Ratio', '95% CI Lower', '95% CI Upper', 'p-value']].round(3)\n","\n","print(\"=\" * 70)\n","print(\"📋 TABLE 5: Logistic Regression (Risk Factors for Severe Dry Eye)\")\n","print(\"=\" * 70)\n","display(table5)\n","\n","table5.to_csv('table5_odds_ratios.csv')\n","print(\"✅ Table 5 saved to CSV!\")"]},{"cell_type":"code","execution_count":17,"id":"13da7976","metadata":{"execution":{"iopub.execute_input":"2026-09-06T13:39:15.959272Z","iopub.status.busy":"2026-09-06T13:39:15.959028Z","iopub.status.idle":"2026-09-06T13:39:15.974327Z","shell.execute_reply":"2026-09-06T13:39:15.973516Z"},"papermill":{"duration":0.028614,"end_time":"2026-09-06T13:39:15.976046+00:00","exception":false,"start_time":"2026-09-06T13:39:15.947432+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["============================================================\n","✅ MACHINE LEARNING MATRICES READY!\n","📐 Training Set : 320 samples\n","📐 Testing Set  : 80 samples\n","📊 Class balance in Train: {0: np.int64(239), 1: np.int64(81)}\n","📊 Class balance in Test : {0: np.int64(60), 1: np.int64(20)}\n","============================================================\n"]}],"source":["# ============================================================\n","# PREPARE DATASET FOR MACHINE LEARNING\n","# ============================================================\n","\n","# 1